<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Maklumat Peribadi Ahli PRS313</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 font-sans">

    <!-- Header / Navigation -->
    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-users-gear text-3xl"></i>
                <div>
                    <h1 class="text-xl font-bold leading-tight">SISTEM MAKLUMAT AHLI PRS313</h1>
                    <p class="text-xs text-indigo-200">Direktori & Profil Ahli Berdaftar</p>
                </div>
            </div>
            <button onclick="openRegisterModal()" class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg font-medium shadow flex items-center gap-2 transition">
                <i class="fa-solid fa-user-plus"></i> Daftar Ahli Baharu
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8">
        
        <!-- Search & Filter Bar -->
        <div class="bg-white p-4 rounded-xl shadow-md mb-8 flex flex-col md:flex-row gap-4 justify-between items-center">
            <div class="relative w-full md:w-1/2">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-3.5 text-slate-400"></i>
                <input type="text" id="searchInput" onkeyup="filterMembers()" placeholder="Cari mengikut nama, No IC, atau jawatan..." 
                       class="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div class="flex gap-2 w-full md:w-auto">
                <select id="genderFilter" onchange="filterMembers()" class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">Semua Jantina</option>
                    <option value="Lelaki">Lelaki</option>
                    <option value="Perempuan">Perempuan</option>
                </select>
                <button onclick="resetFilters()" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg text-sm font-medium transition">
                    Reset
                </button>
            </div>
        </div>

        <!-- Members Card Grid -->
        <div id="membersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Kad ahli akan dijana di sini oleh JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-12">
            <i class="fa-regular fa-folder-open text-5xl text-slate-300 mb-3"></i>
            <p class="text-slate-500 font-medium">Tiada rekod ahli dijumpai.</p>
        </div>
    </main>

    <!-- MODAL 1: Lihat Profil Penuh Ahli -->
    <div id="profileModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden z-50 flex justify-center items-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl relative animate-fade-in">
            <button onclick="closeModal('profileModal')" class="absolute top-4 right-4 bg-slate-100 hover:bg-slate-200 rounded-full p-2 text-slate-600 transition">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div id="profileDetailContent" class="p-6">
                <!-- Content injected dynamically -->
            </div>
        </div>
    </div>

    <!-- MODAL 2: Borang Pendaftaran Ahli -->
    <div id="registerModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden z-50 flex justify-center items-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl p-6 relative">
            <button onclick="closeModal('registerModal')" class="absolute top-4 right-4 bg-slate-100 hover:bg-slate-200 rounded-full p-2 text-slate-600 transition">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            
            <h2 class="text-xl font-bold text-slate-800 mb-6 border-b pb-2"><i class="fa-solid fa-user-plus text-indigo-600"></i> Borang Pendaftaran Ahli PRS313</h2>
            
            <form id="addMemberForm" onsubmit="handleFormSubmit(event)" class="space-y-6">
                <!-- Gambar -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Gambar Profil Ahli</label>
                    <input type="file" id="inputGambar" accept="image/*" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                </div>

                <!-- Maklumat Peribadi -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Nama Penuh *</label>
                        <input type="text" id="inputNama" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">No. IC *</label>
                        <input type="text" id="inputIC" required placeholder="e.g. 900101-01-1234" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">No. Telefon</label>
                        <input type="tel" id="inputTel" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Emel</label>
                        <input type="email" id="inputEmel" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Jantina</label>
                        <select id="inputJantina" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="Lelaki">Lelaki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Agama</label>
                        <input type="text" id="inputAgama" value="Islam" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Status Berkahwin</label>
                        <select id="inputStatusKahwin" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="Berkahwin">Berkahwin</option>
                            <option value="Bujang">Bujang</option>
                            <option value="Duda/Janda">Duda / Janda</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Jawatan</label>
                        <input type="text" id="inputJawatan" placeholder="e.g. Ahli Jawatankuasa" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Alamat</label>
                        <textarea id="inputAlamat" rows="2" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
                    </div>
                </div>

                <!-- Maklumat Pasangan -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <h3 class="font-bold text-slate-700 text-sm mb-3"><i class="fa-solid fa-heart text-rose-500"></i> Maklumat Pasangan</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <input type="text" id="inputNamaPasangan" placeholder="Nama Pasangan" class="p-2 border rounded-lg text-sm">
                        <input type="text" id="inputICPasangan" placeholder="No IC Pasangan" class="p-2 border rounded-lg text-sm">
                        <input type="text" id="inputTelPasangan" placeholder="No Tel Pasangan" class="p-2 border rounded-lg text-sm">
                    </div>
                </div>

                <!-- Maklumat Anak (Accordion/Tanggungan) -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <h3 class="font-bold text-slate-700 text-sm mb-3"><i class="fa-solid fa-child text-amber-500"></i> Maklumat Anak (Tanggungan)</h3>
                    <div id="childrenContainer" class="space-y-3 max-h-60 overflow-y-auto pr-2">
                        <!-- Generates inputs for children 1-8 -->
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t">
                    <button type="button" onclick="closeModal('registerModal')" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg">Batal</button>
                    <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow">Simpan Ahli</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script Utama -->
    <script>
        // Contoh Data Awal
        let membersData = JSON.parse(localStorage.getItem('prs313_members')) || [
            {
                id: 1,
                nama: "Ahmad Bin Zulkifli",
                ic: "880512-02-5431",
                tel: "012-3456789",
                jantina: "Lelaki",
                agama: "Islam",
                statusKahwin: "Berkahwin",
                emel: "ahmad@prs313.com",
                alamat: "No 12, Jalan Bunga Raya, Alor Setar, Kedah",
                jawatan: "Pengerusi",
                gambar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300",
                pasangan: { nama: "Siti Nurhaliza", ic: "900101-02-5678", tel: "019-8765432" },
                anak: [
                    { nama: "Muhammad Ali", ic: "140101-02-1111", tel: "" },
                    { nama: "Nur Aisyah", ic: "160202-02-2222", tel: "" }
                ]
            }
        ];

        // Sediakan Input Anak 1-8 dalam borang
        const childrenContainer = document.getElementById('childrenContainer');
        for (let i = 1; i <= 8; i++) {
            childrenContainer.innerHTML += `
                <div class="p-2 border border-slate-200 rounded bg-white">
                    <span class="text-xs font-bold text-indigo-600 block mb-1">Anak ${i}</span>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                        <input type="text" id="anak_${i}_nama" placeholder="Nama Anak ${i}" class="p-1.5 border rounded text-xs">
                        <input type="text" id="anak_${i}_ic" placeholder="No IC" class="p-1.5 border rounded text-xs">
                        <input type="text" id="anak_${i}_tel" placeholder="No Tel" class="p-1.5 border rounded text-xs">
                    </div>
                </div>
            `;
        }

        function renderMembers(data = membersData) {
            const grid = document.getElementById('membersGrid');
            const emptyState = document.getElementById('emptyState');
            grid.innerHTML = '';

            if (data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            data.forEach(member => {
                const imgUrl = member.gambar || 'https://via.placeholder.com/150?text=Tiada+Gambar';
                grid.innerHTML += `
                    <div class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-xl transition flex flex-col">
                        <div class="relative h-48 bg-slate-200">
                            <img src="${imgUrl}" alt="${member.nama}" class="w-full h-full object-cover">
                            <span class="absolute top-3 right-3 bg-indigo-600/90 backdrop-blur-md text-white text-xs px-2.5 py-1 rounded-full font-medium">
                                ${member.jawatan || 'Ahli'}
                            </span>
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg leading-tight mb-1">${member.nama}</h3>
                                <p class="text-xs text-slate-500 mb-3"><i class="fa-regular fa-id-card mr-1"></i>${member.ic}</p>
                                
                                <div class="space-y-1 text-xs text-slate-600 mb-4">
                                    <p><i class="fa-solid fa-phone mr-2 text-indigo-500"></i>${member.tel || '-'}</p>
                                    <p><i class="fa-solid fa-envelope mr-2 text-indigo-500"></i>${member.emel || '-'}</p>
                                </div>
                            </div>

                            <button onclick="viewProfile(${member.id})" class="w-full py-2 px-4 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold rounded-lg text-xs transition flex justify-center items-center gap-2">
                                <i class="fa-solid fa-eye"></i> Lihat Profil Penuh
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function filterMembers() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const gender = document.getElementById('genderFilter').value;

            const filtered = membersData.filter(m => {
                const matchSearch = m.nama.toLowerCase().includes(search) || m.ic.includes(search) || (m.jawatan && m.jawatan.toLowerCase().includes(search));
                const matchGender = gender === '' || m.jantina === gender;
                return matchSearch && matchGender;
            });

            renderMembers(filtered);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('genderFilter').value = '';
            renderMembers();
        }

        function viewProfile(id) {
            const m = membersData.find(item => item.id === id);
            if (!m) return;

            const content = document.getElementById('profileDetailContent');
            const imgUrl = m.gambar || 'https://via.placeholder.com/150?text=Tiada+Gambar';

            let anakHtml = '';
            if (m.anak && m.anak.length > 0) {
                anakHtml = m.anak.map((a, idx) => `
                    <div class="bg-slate-50 p-3 rounded-lg text-xs border border-slate-100 flex justify-between items-center">
                        <div>
                            <span class="font-bold text-slate-700">${idx+1}. ${a.nama}</span>
                            <p class="text-slate-400">IC: ${a.ic || '-'} | Tel: ${a.tel || '-'}</p>
                        </div>
                    </div>
                `).join('');
            } else {
                anakHtml = '<p class="text-xs text-slate-400 italic">Tiada maklumat anak.</p>';
            }

            content.innerHTML = `
                <div class="text-center mb-6">
                    <img src="${imgUrl}" class="w-28 h-28 rounded-full object-cover mx-auto shadow-md border-4 border-indigo-100 mb-3">
                    <h2 class="text-xl font-bold text-slate-800">${m.nama}</h2>
                    <span class="inline-block bg-indigo-100 text-indigo-800 text-xs px-3 py-1 rounded-full font-medium mt-1">${m.jawatan || 'Ahli'}</span>
                </div>

                <div class="grid grid-cols-2 gap-4 text-xs bg-slate-50 p-4 rounded-xl mb-6">
                    <div><span class="text-slate-400 block">No IC:</span><span class="font-medium text-slate-700">${m.ic}</span></div>
                    <div><span class="text-slate-400 block">No Telefon:</span><span class="font-medium text-slate-700">${m.tel || '-'}</span></div>
                    <div><span class="text-slate-400 block">Jantina:</span><span class="font-medium text-slate-700">${m.jantina || '-'}</span></div>
                    <div><span class="text-slate-400 block">Agama:</span><span class="font-medium text-slate-700">${m.agama || '-'}</span></div>
                    <div><span class="text-slate-400 block">Status:</span><span class="font-medium text-slate-700">${m.statusKahwin || '-'}</span></div>
                    <div><span class="text-slate-400 block">Emel:</span><span class="font-medium text-slate-700">${m.emel || '-'}</span></div>
                    <div class="col-span-2"><span class="text-slate-400 block">Alamat:</span><span class="font-medium text-slate-700">${m.alamat || '-'}</span></div>
                </div>

                <div class="mb-6">
                    <h4 class="font-bold text-sm text-slate-700 mb-2 border-b pb-1"><i class="fa-solid fa-heart text-rose-500 mr-2"></i>Maklumat Pasangan</h4>
                    <div class="bg-rose-50/50 p-3 rounded-lg text-xs grid grid-cols-3 gap-2 border border-rose-100">
                        <div><span class="text-slate-400 block">Nama:</span><span class="font-medium">${m.pasangan?.nama || '-'}</span></div>
                        <div><span class="text-slate-400 block">No IC:</span><span class="font-medium">${m.pasangan?.ic || '-'}</span></div>
                        <div><span class="text-slate-400 block">No Tel:</span><span class="font-medium">${m.pasangan?.tel || '-'}</span></div>
                    </div>
                </div>

                <div>
                    <h4 class="font-bold text-sm text-slate-700 mb-2 border-b pb-1"><i class="fa-solid fa-child text-amber-500 mr-2"></i>Maklumat Anak / Tanggungan</h4>
                    <div class="space-y-2">
                        ${anakHtml}
                    </div>
                </div>
            `;

            document.getElementById('profileModal').classList.remove('hidden');
        }

        function openRegisterModal() {
            document.getElementById('registerModal').classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('inputGambar');
            const file = fileInput.files[0];

            const saveMember = (imgBase64) => {
                const anakList = [];
                for (let i = 1; i <= 8; i++) {
                    const n = document.getElementById(`anak_${i}_nama`).value;
                    const ic = document.getElementById(`anak_${i}_ic`).value;
                    const t = document.getElementById(`anak_${i}_tel`).value;
                    if (n) anakList.push({ nama: n, ic: ic, tel: t });
                }

                const newMember = {
                    id: Date.now(),
                    nama: document.getElementById('inputNama').value,
                    ic: document.getElementById('inputIC').value,
                    tel: document.getElementById('inputTel').value,
                    emel: document.getElementById('inputEmel').value,
                    jantina: document.getElementById('inputJantina').value,
                    agama: document.getElementById('inputAgama').value,
                    statusKahwin: document.getElementById('inputStatusKahwin').value,
                    jawatan: document.getElementById('inputJawatan').value,
                    alamat: document.getElementById('inputAlamat').value,
                    gambar: imgBase64,
                    pasangan: {
                        nama: document.getElementById('inputNamaPasangan').value,
                        ic: document.getElementById('inputICPasangan').value,
                        tel: document.getElementById('inputTelPasangan').value
                    },
                    anak: anakList
                };

                membersData.push(newMember);
                localStorage.setItem('prs313_members', JSON.stringify(membersData));
                renderMembers();
                closeModal('registerModal');
                document.getElementById('addMemberForm').reset();
            };

            if (file) {
                const reader = new FileReader();
                reader.onloadend = function () {
                    saveMember(reader.result);
                };
                reader.readAsDataURL(file);
            } else {
                saveMember('https://via.placeholder.com/150?text=Tiada+Gambar');
            }
        }

        // Inisialisasi awal
        renderMembers();
    </script>
</body>
</html>
